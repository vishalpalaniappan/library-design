design("library_manager")

actor librarian {
    # Used to include files in the synthesized output
    # This would mean that registered.py should be included in the
    # synthesized output folder. I will also use this to add an import
    # statement to the synthesized actor.
    # include("registered.py")

    behavior b_getName {
        create(name=name, type="string", role="name")
        _getTerminalInput(name, "Enter your name: ")
        set(worldState, ["name"], name)
        select(b_sayHi)
    }

    behavior b_sayHi {
        get(name, worldState, ["name"])
        display("f'Hello {name}'")
        select(test)
    }

    behavior test {
        select(b_getName)
    }

    run(b_getName)
}