design("library_manager")

#participant_type BASKET {
#   Placeholder for participant type declaration
#   Establish participant metadata here
#   This includes the domain structure of the participant
#   that is passed to CLP.
#}

#TODO: Extend design so it places book on the shelf after reading first letter.

include("registered.py")
include("computable_units.py")

#=============================
#   Initialize World State
#=============================
behavior initWorldState {
    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="basket",
        value=[],
        p_type="BASKET", 
        p_role="BOOK_BASKET", 
        is_input=False
    )
    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="choice_prompt",
        value="\nGet user choice (a for add book, g for get book, d for display, else exit): ", 
        p_type="STRING", 
        p_role="CHOICE_PROMPT", 
        is_input=False
    )
    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="book_name_prompt",
        value="\nPlease enter book name: ", 
        p_type="STRING", 
        p_role="BOOK_NAME_PROMPT", 
        is_input=False
    )
    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="basket_position_prompt",
        value="\nPlease enter position to get from basket: ", 
        p_type="STRING", 
        p_role="BASKET_POSITION_PROMPT", 
        is_input=False
    )
    select{
        goToBehavior(acceptChoice)   
    }
}


#=============================
#      Get Choice
#=============================
behavior acceptChoice {
    worldStateManager(
        save_in=choice_prompt, 
        transformation=getValue, 
        name="choice_prompt",
        p_type="STRING", 
        p_role="CHOICE_PROMPT"
    )
    _getInput(choice, choice_prompt)
    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="choice",
        value=choice,
        p_type="CHOICE", 
        p_role="USER_CHOICE", 
        is_input=True
    )
    select{
        goToBehavior(
            default=displayChoice, 
            restoring=acceptChoice
        )   
    }
}


#=============================
#      Display Choice
#=============================
behavior displayChoice {
    worldStateManager(
        save_in=choice, 
        transformation=getValue, 
        name="choice",
        p_type="CHOICE", 
        p_role="USER_CHOICE"
    )
    _printFormattedString(null, f"User Choice: {choice}")
    select{
        goToBehavior(evaluateChoice)   
    }
}


#=============================
#      Evaluate Choice
#=============================
behavior evaluateChoice {
    select{
        worldStateManager(
            save_in=choice, 
            transformation=getValue, 
            name="choice",
            p_type="CHOICE", 
            p_role="USER_CHOICE"
        )
        _isEqual(isAdd, choice, "a")
        _isEqual(isGet, choice, "g")
        _isEqual(isDisplay, choice, "d")
        if (isAdd) {
            goToBehavior(addBookChoice)
        }
        if (isGet) {
            goToBehavior(getBookChoice)
        }
        if (isDisplay) {
            goToBehavior(displayBasketChoice)
        }
    }
}


#=============================
#      Add Book Choice
#=============================
behavior addBookChoice {
    select{
        goToBehavior(getName)
    }
}


#=============================
#      Get Book Choice
#=============================
behavior getBookChoice {
    select{
        goToBehavior(acceptPosition)
    }
}


#=============================
#   Get Display Basket Choice
#=============================
behavior displayBasketChoice {
    select{
        goToBehavior(showBasket)
    }
}

#=============================
#      Accept Position
#=============================
behavior acceptPosition {
    _getInput(position_str, "\nPlease enter position to get from basket: ")        
    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="position_str",
        value=position_str,
        p_type="POSITION", 
        p_role="BASKET_POSITION_STR", 
        is_input=True
    )   
    select{
        goToBehavior(
            default=convertToNumber, 
            restoring=acceptPosition
        )   
    }
}

#=============================
#      Convert To Number
#=============================
behavior convertToNumber {
    worldStateManager(
        save_in=position_str, 
        transformation=getValue, 
        name="position_str",
        p_type="POSITION", 
        p_role="BASKET_POSITION_STR"
    )
    _convertStrToNumberInt(position, position_str)

    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="position",
        value=position,
        p_type="POSITION", 
        p_role="BASKET_POSITION", 
        is_input=False
    )   
    select{
        goToBehavior(getBookFromBasket)
    }
}


#=============================
#      Get Book From Basket
#=============================
behavior getBookFromBasket {
    worldStateManager(
        save_in=basket, 
        transformation=getValue, 
        name="basket",
        p_type="BASKET", 
        p_role="BOOK_BASKET"
    )
    worldStateManager(
        save_in=position, 
        transformation=getValue, 
        name="position",
        p_type="POSITION", 
        p_role="BASKET_POSITION"
    )

    _getFromPosition(book, basket, position)
    _removeFromPosition(null, basket, position)

    worldStateManager(
        save_in=null, 
        transformation=add, 
        name="book",
        value=book,
        p_type="BOOK", 
        p_role="BOOK_W_NAME", 
        is_input=False
    )
    select{
        goToBehavior(getBookName)
    }
}

#=============================
#      Get Book Name
#=============================
behavior getBookName {
    worldStateManager(
        save_in=book, 
        transformation=getValue, 
        name="book",
        p_type="BOOK", 
        p_role="BOOK_W_NAME"
    )

    _getNestedValue(name, book, ["name"])

    worldStateManager(
        save_in=null, 
        transformation=add, 
        name="name",
        value=name,
        p_type="NAME", 
        p_role="BOOK_NAME", 
        is_input=False
    )   
    select{
        goToBehavior(getFirstLetterOfBookName)
    }
}

#======================================
#      Get First Letter of Book Name
#=====================================
behavior getFirstLetterOfBookName {
    worldStateManager(
        save_in=name, 
        transformation=getValue, 
        name="name",
        p_type="NAME", 
        p_role="BOOK_NAME"
    )
    
    _getFirstCharacter(firstLetter, name)
    _printFormattedString(null, f"Got book named {name} and it has first letter {firstLetter}")
    
    worldStateManager(
        save_in=null, 
        transformation=remove, 
        name="book"
    )  
    select{
        goToBehavior(acceptChoice)
    }
}

#=============================
#      Get Book From Basket
#=============================
behavior getName {
    _getInput(name, "\nPlease enter book name: ")
    
    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="name",
        value=name,
        p_type="NAME", 
        p_role="BOOK_NAME", 
        is_input=True
    )
    select{
        goToBehavior(
            default=createBook, 
            restoring=getName
        )   
    }
}

#=============================
#     Create Book
#=============================
behavior createBook {
    worldStateManager(
        save_in=name, 
        transformation=getValue, 
        name="name",
        p_type="NAME", 
        p_role="BOOK_W_NAME"
    )

    _setNestedValue(book, {}, ["name"], name)

    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="book",
        value=book,
        p_type="BOOK", 
        p_role="BOOK_W_NAME", 
        is_input=False
    )   
    worldStateManager(
        save_in=null, 
        transformation=remove, 
        name="name"
    )
    select{
        goToBehavior(addBookToBasket)
    }
}

#=============================
#      Add Book To Basket
#=============================
behavior addBookToBasket {
    worldStateManager(
        save_in=book, 
        transformation=get, 
        name="book",
        p_type="BOOK", 
        p_role="BOOK_W_NAME"
    )
    worldStateManager(
        save_in=basket, 
        transformation=getValue, 
        name="basket",
        p_type="BASKET", 
        p_role="BOOK_BASKET"
    )

    _insertIntoList(basket, basket, 0, book)

    worldStateManager(
        save_in=null, 
        transformation=update, 
        name="basket",
        value=basket,
        p_type="BASKET", 
        p_role="BOOK_BASKET"
    )   
    worldStateManager(
        save_in=null, 
        transformation=remove, 
        name="book"
    )
    select{
        goToBehavior(acceptChoice)
    }
}

#=============================
#      Show Basket
#=============================
behavior showBasket {
    worldStateManager(
        save_in=basket, 
        transformation=getValue, 
        name="basket",
        p_type="BASKET", 
        p_role="BOOK_BASKET"
    )
    _printFormattedString(null, f"Basket Contents: {basket}")
    select{
        goToBehavior(acceptChoice)
    }
}

run(initWorldState)