design("library_manager")

actor librarian {
    include("registered.py")
    include("computable_units.py")

    behavior createBasket {
        create(name=basket, type="list", role="basket", accepts="book")
        set("basket",[],[])
        worldStateManager(null, "add", "basket", basket, False)
        select(getChoice)
    }

    behavior getChoice {
        getInput(choice, "\nGet user choice (a for add book, g for get book, else exit): ")
        worldStateManager(null, "add", "choice", choice, True)
        select(displayChoice)
    }

    behavior displayChoice {
        worldStateManager(choice, "getValue", "choice")
        display("f'User Choice: {choice}'")
        select(evaluateChoice)
    }

    behavior evaluateChoice {
        worldStateManager(choice, "getValue", "choice")
        _isEqual(isAdd, choice, "a")
        _isEqual(isGet, choice, "g")
        if (isAdd) {
            select(addBookChoice)
        }
        if (isGet) {
            select(getBookChoice)
        }
    }

    behavior addBookChoice {
        select(getName)
    }

    behavior getBookChoice {
        select(getBookFromBasket)
    }

    behavior getBookFromBasket {
        worldStateManager(basket, "getValue", "basket")
        _getFromPosition(book, basket, 0)
        _removeFromPosition(null, basket, 0)
        worldStateManager(null, "add", "book", book, False)
        select(getFirstLetterOfBookName)
    }

    behavior getFirstLetterOfBookName {
        worldStateManager(book, "getValue", "book")
        get(name, book, ["name"])
        _getFromPosition(firstLetter, name, 0)
        display("f'Got book named {name} and it has first letter {firstLetter}'")
        worldStateManager(null, "add", "firstLetter", firstLetter, False)
        worldStateManager(null, "remove", "firstLetter")
        worldStateManager(null, "remove", "book")
        select(getChoice)
    }

    behavior getName {
        create(name=name, type="string", role="name")
        getInput(name, "\nPlease enter book name: ")
        worldStateManager(null, "add", "name", name, True)        
        select(createBook)
    }

    behavior createBook {
        worldStateManager(name, "getValue", "name")
        create(name=book, type="object", role="book")
        set(book, [], {})
        set(book, ["name"], name)
        worldStateManager(null, "add", "book", book, False)
        worldStateManager(null, "remove", "name")
        select(addBookToBasket)
    }

    behavior addBookToBasket {
        worldStateManager(book, "get", "book")
        worldStateManager(basket, "getValue", "basket")
        _insertIntoList(basket, basket, book, 0)
        worldStateManager(null, "update", "basket", basket)
        worldStateManager(null, "remove", "book")
        select(showBasket)
    }

    behavior showBasket {
        worldStateManager(basket, "getValue", "basket")
        display("f'Basket Contents: {basket}'")
        select(getChoice)
    }

    run(createBasket)
}