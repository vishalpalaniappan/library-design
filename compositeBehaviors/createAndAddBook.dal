compositeBehavior("createAndAddBook")
include("registered.py")
include("computable_units.py")

#=============================
#     Create Book
#=============================
behavior createBook {
    worldStateManager(
        save_in=name, 
        transformation=getValue, 
        name="name",
        p_type="NAME", 
        p_role="BOOK_W_NAME"
    )

    _setNestedValue(book, {}, ["name"], name)

    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="book",
        value=book,
        p_type="BOOK", 
        p_role="BOOK_W_NAME", 
        is_input=False
    )   
    worldStateManager(
        save_in=null, 
        transformation=remove, 
        name="name"
    )
    select{
        goToBehavior(addBookToBasket)
    }
}

#=============================
#      Add Book To Basket
#=============================
behavior addBookToBasket {
    worldStateManager(
        save_in=book, 
        transformation=get, 
        name="book",
        p_type="BOOK", 
        p_role="BOOK_W_NAME"
    )
    worldStateManager(
        save_in=basket, 
        transformation=getValue, 
        name="basket",
        p_type="BASKET", 
        p_role="BOOK_BASKET"
    )

    _insertIntoList(basket, basket, 0, book)

    worldStateManager(
        save_in=null, 
        transformation=update, 
        name="basket",
        value=basket,
        p_type="BASKET", 
        p_role="BOOK_BASKET"
    )   
    worldStateManager(
        save_in=null, 
        transformation=remove, 
        name="book"
    )
}

run(createBook)