compositeBehavior("getBookAndShelvingIndex")
include("registered.py")
include("computable_units.py")

#=============================
#      Convert To Number
#=============================
behavior convertToNumber {
    worldStateManager(
        save_in=position_str, 
        transformation=getValue, 
        name="position_str",
        p_type="POSITION", 
        p_role="BASKET_POSITION_STR"
    )
    _convertStrToNumber(position, position_str)

    worldStateManager(
        save_in=null, 
        transformation=create, 
        name="position",
        value=position,
        p_type="POSITION", 
        p_role="BASKET_POSITION", 
        is_input=False
    )   
    select{
        goToBehavior(getBookFromBasket)
    }
}

#=============================
#      Get Book From Basket
#=============================
behavior getBookFromBasket {
    worldStateManager(
        save_in=basket, 
        transformation=getValue, 
        name="basket",
        p_type="BASKET", 
        p_role="BOOK_BASKET"
    )
    worldStateManager(
        save_in=position, 
        transformation=getValue, 
        name="position",
        p_type="POSITION", 
        p_role="BASKET_POSITION"
    )

    _getFromPosition(book, basket, position)
    _removeFromPosition(null, basket, position)

    worldStateManager(
        save_in=null, 
        transformation=add, 
        name="book",
        value=book,
        p_type="BOOK", 
        p_role="BOOK_W_NAME", 
        is_input=False
    )
    select{
        goToBehavior(getBookName)
    }
}

#=============================
#      Get Book Name
#=============================
behavior getBookName {
    worldStateManager(
        save_in=book, 
        transformation=getValue, 
        name="book",
        p_type="BOOK", 
        p_role="BOOK_W_NAME"
    )

    _getNestedValue(name, book, ["name"])

    worldStateManager(
        save_in=null, 
        transformation=add, 
        name="name",
        value=name,
        p_type="NAME", 
        p_role="BOOK_NAME", 
        is_input=False
    )   
    select{
        goToBehavior(getFirstLetterOfBookName)
    }
}

#======================================
#      Get First Letter of Book Name
#=====================================
behavior getFirstLetterOfBookName {
    worldStateManager(
        save_in=name, 
        transformation=getValue, 
        name="name",
        p_type="NAME", 
        p_role="BOOK_NAME"
    )
    
    _getFirstCharacter(firstLetter, name)
    _printFormattedString(null, f"Got book named {name} and it has first letter {firstLetter}")
    
    worldStateManager(
        save_in=null, 
        transformation=remove, 
        name="book"
    )  
}

run(convertToNumber)